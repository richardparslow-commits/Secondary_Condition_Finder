# Secondary Condition Finder — server-only environment example
# Copy to .env.local for local dev, or configure in Vercel Project Settings → Environment Variables (Production / Preview / Development).
# Never commit real secrets. Never prefix server-only keys with NEXT_PUBLIC_.

# ── Workflow-session crypto ─────────────────────────────────────────────
# Must be ≥ 32 random characters in production; fails closed when absent/short.
WORKFLOW_SESSION_SECRET=
# Legacy fallback — new deployments must use WORKFLOW_SESSION_SECRET:
# SECONDARY_WORKFLOW_SESSION_SECRET=

# ── LangSmith tracing + Engine (server-only) ────────────────────────────
# When disabled (default) the app does no LangSmith I/O.
# Enable only after you have a project-scoped LangSmith API key.
# See docs/langsmith-engine-setup.md for where to obtain these values
# and how to connect the GitHub repository to LangSmith Engine so it can
# open automated diagnostic PRs.
LANGSMITH_TRACING=false            # set to "true" to emit traces
LANGSMITH_API_KEY=                 # project-scoped key: lsv2_pt_... (Settings → API Keys)
LANGSMITH_PROJECT=secondary-condition-finder  # stable project name; Engine clusters by project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # change only for EU/APAC tenants

# ── VA public-reference (disabled by default) ───────────────────────────
# Full contract lives in docs/va-api-runtime-configuration.md and docs/deployment-readiness.md.
# VA_API_ENABLED is the deliberate enable flag; VA_API_ENV alone does NOT enable network access.
# VA_SANDBOX_* / VA_PRODUCTION_* below follow the same rule — production additionally requires VA_PRODUCTION_ACCESS_GRANTED=true.
VA_API_ENV=sandbox
VA_API_ENABLED=false
# VA_API_TIMEOUT_MS=4000

# Sandbox credentials (use only for intentional sandbox operation):
# VA_FORMS_SANDBOX_API_KEY=
# VA_BENEFITS_REFERENCE_SANDBOX_API_KEY=
# VA_ACCREDITED_REP_SANDBOX_API_KEY=           # Phase 3.1 locator — also requires VA_ACCREDITED_REP_ENABLED=true
# VA_FORMS_SANDBOX_BASE_URL=
# VA_BENEFITS_REFERENCE_SANDBOX_BASE_URL=
# VA_ACCREDITED_REP_SANDBOX_BASE_URL=

# Production credentials — do NOT configure until VA grants production access and transition is reviewed:
# VA_FORMS_PRODUCTION_API_KEY=
# VA_BENEFITS_REFERENCE_PRODUCTION_API_KEY=
# VA_ACCREDITED_REP_PRODUCTION_API_KEY=
# VA_FORMS_PRODUCTION_BASE_URL=
# VA_BENEFITS_REFERENCE_PRODUCTION_BASE_URL=
# VA_ACCREDITED_REP_PRODUCTION_BASE_URL=
# VA_PRODUCTION_ACCESS_GRANTED=false

# ── Optional preflight enrichment ───────────────────────────────────────
# REGULATIONS_GOV_API_KEY=
# REGULATORY_PREFLIGHT_MAX_AGE_HOURS=24
# REGULATORY_PREFLIGHT_SOURCE_TIMEOUT_MS=8000
