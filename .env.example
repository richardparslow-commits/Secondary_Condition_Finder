# Secondary Condition Finder — server-only environment example
# Copy to .env.local for local dev, or configure in Vercel Project Settings → Environment Variables (Production / Preview / Development).
# Never commit real secrets. Never prefix server-only keys with NEXT_PUBLIC_.

# ── Workflow-session crypto ─────────────────────────────────────────────
# Must be ≥ 32 random characters in production; fails closed when absent/short.
WORKFLOW_SESSION_SECRET=
# Legacy fallback retired 2026-10-10 (REL-04 follow-up) — no longer read; do not set:
# SECONDARY_WORKFLOW_SESSION_SECRET=

# ── LangSmith tracing + Engine (server-only) ────────────────────────────
# When disabled (default) the app does no LangSmith I/O.
# Enable only after you have a project-scoped LangSmith API key.
# See docs/langsmith-engine-setup.md for where to obtain these values
# and how to connect the GitHub repository to LangSmith Engine so it can
# open automated diagnostic PRs.
LANGSMITH_TRACING=false            # set to "true" to emit traces
LANGSMITH_API_KEY=                 # project-scoped key: lsv2_pt_... (Settings → API Keys)
LANGSMITH_PROJECT=secondary-condition-finder  # stable project name; Engine clusters by project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # change only for EU/APAC tenants

# ── VA public-reference (disabled by default) ───────────────────────────
# Full contract lives in docs/va-api-runtime-configuration.md and docs/deployment-readiness.md.
# VA_API_ENABLED is the deliberate enable flag; VA_API_ENV alone does NOT enable network access.
# VA_SANDBOX_* / VA_PRODUCTION_* below follow the same rule — production additionally requires VA_PRODUCTION_ACCESS_GRANTED=true.
VA_API_ENV=sandbox
VA_API_ENABLED=false
# VA_API_TIMEOUT_MS=4000

# Sandbox credentials (use only for intentional sandbox operation):
# VA_FORMS_SANDBOX_API_KEY=
# VA_BENEFITS_REFERENCE_SANDBOX_API_KEY=
# VA_ACCREDITED_REP_SANDBOX_API_KEY=           # Phase 3.1 locator — also requires VA_ACCREDITED_REP_ENABLED=true
# VA_FORMS_SANDBOX_BASE_URL=
# VA_BENEFITS_REFERENCE_SANDBOX_BASE_URL=
# VA_ACCREDITED_REP_SANDBOX_BASE_URL=

# Production credentials — do NOT configure until VA grants production access and transition is reviewed:
# VA_FORMS_PRODUCTION_API_KEY=
# VA_BENEFITS_REFERENCE_PRODUCTION_API_KEY=
# VA_ACCREDITED_REP_PRODUCTION_API_KEY=
# VA_FORMS_PRODUCTION_BASE_URL=
# VA_BENEFITS_REFERENCE_PRODUCTION_BASE_URL=
# VA_ACCREDITED_REP_PRODUCTION_BASE_URL=
# VA_PRODUCTION_ACCESS_GRANTED=false
# Controlled check BEFORE app activation (requires real VA grant + production keys):
# node scripts/verify-va-production-reference.mts --confirm-va-production-access
# Keep VA_API_ENABLED=false during that check; it does not close #287.

# ── VA reference shared cache (optional, for finding #3 multi-instance hit rate) ─
# When configured, VA reference data is cached in a shared KV (e.g. Upstash Redis
# REST / Vercel KV) so every serverless instance shares hits; without it the
# existing process-local LRU-32 / 5-min cache is used (disabled in distributed).
# Configure EITHER the canonical pair OR one of the vendor aliases — all map to
# the same Upstash-compatible REST endpoint.
# VA_REFERENCE_SHARED_CACHE_URL=https://<id>.upstash.io        # https REST URL (Upstash/Redis REST compatible)
# VA_REFERENCE_SHARED_CACHE_TOKEN=<server-only REST token>       # bearer token for the KV
# VA_REFERENCE_SHARED_CACHE_PREFIX=va:ref:                      # same store/prefix across this VA consumer's fleet
# VA_SHARED_CONSUMER_BUDGET=false                              # explicit opt-in required for distributed live access
# Cache configuration alone does not enable requests; shared budget/circuit must be reachable and verified.
# Aliases (any one pair is enough):
# VA_REFERENCE_KV_REST_URL / VA_REFERENCE_KV_REST_TOKEN
# UPSTASH_REDIS_REST_URL   / UPSTASH_REDIS_REST_TOKEN           # auto-set by Vercel Upstash integration
# KV_REST_API_URL          / KV_REST_API_TOKEN                  # legacy Vercel KV alias

# ── Read-only veteran account SANDBOX experiment (separate from references) ─
# No production account access, representative roles, claim submission, or upload.
# See docs/va-account-sandbox.md; register each exact callback with VA first.
VA_ACCOUNT_SANDBOX_ENABLED=false
VA_ACCOUNT_ENV=sandbox
# APP_URL=http://localhost:3000            # exact origin, HTTPS unless loopback
# VA_ACCOUNT_SESSION_SECRET=              # independent random secret, >=32 characters
# VA_ACCOUNT_RATINGS_CLIENT_ID=
# VA_ACCOUNT_CLAIMS_CLIENT_ID=
# VA_ACCOUNT_RATINGS_AUTH_METHOD=none       # match issued registration: none or client_secret_basic
# VA_ACCOUNT_CLAIMS_AUTH_METHOD=none
# VA_ACCOUNT_RATINGS_CLIENT_SECRET=         # only for client_secret_basic
# VA_ACCOUNT_CLAIMS_CLIENT_SECRET=
# VA_ACCOUNT_STORE_URL=                    # separate HTTPS Redis-REST session store supporting GETDEL/EVAL
# VA_ACCOUNT_STORE_TOKEN=                  # independent server-only credential
# VA_ACCOUNT_LOCAL_ONLY=true               # explicit loopback development only; refused in production/hosting
# VA_ACCOUNT_DEMO_FIXTURES=false           # demo rehearsal only: answers VA sandbox calls locally; refused on any hosted/production runtime
# VA_ACCOUNT_DEMO_FAULT=none               # demo rehearsal only: none|timeout|503|429|invalid-payload|401

# ── Admin & regulatory sync authentication ─────────────────────────────
# Bearer token for authenticated endpoints: /api/regulatory/preflight and
# /api/admin/cache-clear. Must be ≥ 32 random characters in production.
# Either variable is accepted; REGULATORY_SYNC_SECRET takes precedence.
CRON_SECRET=
# REGULATORY_SYNC_SECRET=

# ── Optional preflight enrichment ───────────────────────────────────────
# REGULATIONS_GOV_API_KEY=
# REGULATORY_PREFLIGHT_MAX_AGE_HOURS=24
# REGULATORY_PREFLIGHT_SOURCE_TIMEOUT_MS=8000

# ── Rate limiting (defense-in-depth behind the edge WAF) ────────────────
# Contract: SECURITY.md "Application-level rate limiting" and docs/operations.md.
# Shared admission ceiling charged on every limited surface, attributed or not.
# Plain decimal digits only; an unusable value falls back to the 6000 default.
# RATE_LIMIT_UNATTRIBUTED_MAX=6000
#
# Declared ingress model — this changes ENFORCEMENT, not only reporting, so it
# must match the real ingress. Accepted forms: set | overwrite | platform (the
# ingress sets the forwarding header to the peer it observed; key = leftmost
# X-Forwarded-For hop, X-Real-IP fallback), append (the ingress appends it;
# key = hop 1 from the right), append:N (key = hop N from the right, 1..8), or
# leave unset for the client-supplied default. Declare the exact appender
# count: with more declared than present, a client that pads the header with an
# extra value becomes the hop that is read. Compare the model and hop reported
# as components.rateLimit.identity on /api/health with what your ingress
# actually writes before recording the claim.
# RATE_LIMIT_TRUSTED_INGRESS=set
