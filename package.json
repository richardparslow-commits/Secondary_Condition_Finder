{
  "name": "secondary-condition-finder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:azure": "AZURE_STATIC_WEB_APPS_BUILD=1 next build && node scripts/package-next-standalone.mjs",
    "start": "next start",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:composition": "node scripts/audit-test-composition.js",
    "typecheck": "tsc --noEmit",
    "citations:weak": "node scripts/report-weak-citations.js",
    "citations:audit": "node scripts/audit-citation-verification.js",
    "citations:decay": "node scripts/audit-citation-decay.js",
    "citations:queue": "node scripts/report-citation-verification-queue.js --markdown",
    "probe:va-gov-walkthrough": "node scripts/probe-va-gov-links.js",
    "audit:me-compliance": "node scripts/audit-me-compliance.js",
    "kb:validate": "node scripts/validate-knowledge-base.js",
    "authoring:tracker": "node scripts/generate-authoring-tracker.js",
    "audit:high": "npm audit --audit-level=high",
    "audit:crg": "node scripts/audit-crg-graph.js",
    "evidence:architecture": "node scripts/audit-evidence-architecture.js",
    "evidence:architecture:markdown": "node scripts/audit-evidence-architecture.js --markdown",
    "deploy:guard:vercel": "node scripts/check-deploy-freeze.js --provider=vercel",
    "regulatory:validate": "node scripts/validate-regulatory-actions.js",
    "regulatory:audit": "node scripts/audit-regulatory-intelligence.js",
    "regulatory:audit:markdown": "node scripts/audit-regulatory-intelligence.js --markdown",
    "regulatory:preflight:test": "vitest run tests/regulatory-preflight.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vercel/otel": "2.1.3",
    "langsmith": "0.10.3",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tesseract.js": "6.0.1",
    "zod": "4.5.4"
  },
  "overrides": {
    "@eslint/config-array": ">=0.23.5",
    "postcss": ">=8.5.18",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "sharp@0.35.0": true,
    "unrs-resolver@1.12.2": true
  }
}
