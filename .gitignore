# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# generated by postinstall (copy-pdf-worker.mjs)
/public/pdf.worker.min.mjs
/public/tesseract/

# typescript
*.tsbuildinfo
next-env.d.ts

# python prototype leftovers
__pycache__/
*.pyc

# local event log
*.db
*.db-wal
*.db-shm

# nested self-contained clone of this repo (has its own .git); not part of this checkout
/Secondary_Condition_Finder/
.aider*

.implement/
CLAUDE.md
.claude.md
.claude/
.opencode/
